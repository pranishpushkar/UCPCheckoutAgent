{
  "name": "a-s30-followup-cheaper",
  "expectToolSequence": ["search_catalog", "propose_purchase", "search_catalog"],
  "turns": [
    { "call": [{ "tool": "search_catalog", "args": { "query": "blue mug", "max_results": 3 } }] },
    { "when": { "tool": "search_catalog", "resultMatches": "\"item_id\":\"item_456\"" },
      "call": [{ "tool": "propose_purchase",
                 "args": { "merchant_id": "${result.items[0].merchant_id}",
                           "items": [{ "item_id": "item_456", "quantity": 1 }],
                           "rationale": "The user asked for one blue mug under $20." } }] },
    { "when": { "tool": "propose_purchase", "resultMatches": "\"state\":\"AWAITING_APPROVAL\"" },
      "text": "I have asked for your approval of 1 Blue Mug." },
    { "call": [{ "tool": "search_catalog", "args": { "query": "mug", "max_results": 5 } }] },
    { "when": { "tool": "search_catalog", "resultMatches": "\"item_id\":\"item_456\"" },
      "text": "There is no cheaper mug than the Blue Mug at ${result.items[0].price} within your budget." }
  ]
}
