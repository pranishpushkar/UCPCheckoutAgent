<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ucplab</groupId>
        <artifactId>ucp-checkout-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-ucp</artifactId>
    <name>Agent UCP client</name>

    <dependencies>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <!-- H3 P2: the gateway contract (MerchantGatewayContract) lives in core's tests, as the repository contracts do. -->
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Section 5.2: the merchant is the system under test for contract tests only. -->
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>merchant</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Section 14 level 4: from M4 the faults the merchant cannot produce go through the fault proxy. -->
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>fault-proxy</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- H1: the wire records of the official sample merchant (docs/interop/fixtures), read by the contract tests only. -->
            <testResource>
                <directory>${project.basedir}/../docs/interop/fixtures</directory>
                <targetPath>interop</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <!-- H5 C10: agent-service's configuration tests run the MCP gateway against McpStore and the recordings. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
