<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ucplab</groupId>
        <artifactId>ucp-checkout-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>eval-harness</artifactId>
    <name>Evaluation harness</name>

    <!-- Section 5.2 (D2): until M6 there is no REST API, so the harness embeds the agent and starts lab merchants in
         process. Never agent-adk or ADK types. -->
    <dependencies>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-ucp</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-persistence</artifactId>
        </dependency>
        <!-- Decision 1: the agent runtime (JDK and core only), never agent-adk, ADK or the Gemini SDK. -->
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>fault-proxy</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>merchant</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- 13.5, section 15, Decision 1: the acceptance report. ./mvnw -B -ntp verify -Peval-full runs the whole
             build, then EvalMain with 200 runs per scenario at time scale 1 on 16 lanes. Its require-full flag
             refuses anything less (exit 3), and any non-zero exit fails the build. The report goes to
             target/eval-full. eval.runs and eval.lanes exist only to check this wiring; the acceptance run uses the
             defaults. -->
        <profile>
            <id>eval-full</id>
            <properties>
                <eval.runs>200</eval.runs>
                <eval.lanes>16</eval.lanes>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>eval-full</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>dev.ucplab.eval.EvalMain</argument>
                                        <argument>--mode</argument>
                                        <argument>scripted</argument>
                                        <argument>--runs</argument>
                                        <argument>${eval.runs}</argument>
                                        <argument>--time-scale</argument>
                                        <argument>1</argument>
                                        <argument>--lanes</argument>
                                        <argument>${eval.lanes}</argument>
                                        <argument>--require-full</argument>
                                        <argument>--out</argument>
                                        <argument>${project.build.directory}/eval-full</argument>
                                    </arguments>
                                    <classpathScope>runtime</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
