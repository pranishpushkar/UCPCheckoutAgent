<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.ucplab</groupId>
    <artifactId>ucp-checkout-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>UCP Checkout Lab</name>

    <!-- Section 15. The merchant module is added before M2. -->
    <modules>
        <module>merchant</module>
        <module>agent-core</module>
        <module>agent-ucp</module>
        <module>agent-persistence</module>
        <module>agent-runtime</module>
        <module>agent-adk</module>
        <module>agent-service</module>
        <module>fault-proxy</module>
        <module>eval-harness</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <archunit.version>1.5.1</archunit.version>
        <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
        <flyway.version>13.12.1</flyway.version>
        <!-- The Gemini SDK (R2, ADR 0004): 1.80.0 (2026-10-29), the newest release at least two weeks old on 2026-11-13;
             2.0.0 to 2.3.0 came out 2026-11-06 to 2026-11-12. ADK for Java was evaluated and not used. -->
        <google-genai.version>1.80.0</google-genai.version>
        <!-- Spring Boot (M6, ADR 0006): 4.1.2 (2026-10-22), the newest release at least two weeks old on 2026-11-13.
             Its BOM is imported by agent-service alone; no other module sees Boot's versions. -->
        <spring-boot.version>4.1.2</spring-boot.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <!-- H3, ADR 0009: PIT, used only by -Pmutation (never bound to a phase). 1.30.2 (2026-11-05) and the JUnit 5 plugin
             1.2.3 (2025-05-20); the jars' signatures were verified with gpg (key 18CD85CBC5C1DB1684C5E59FA8E3B39F19E1CCE7).
             Neither project declares JUnit 6 support; the pair works with Jupiter 6.1.3 and is re-checked on any upgrade. -->
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>agent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Shared test kit (repository contract suites, crash decorators, Lab). Test scope only. -->
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>agent-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>merchant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>agent-ucp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- H5 C10: the scripted Shopify store and its recorded answers, for the service's configuration tests. -->
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>agent-ucp</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>agent-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>agent-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>agent-adk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.ucplab</groupId>
                <artifactId>fault-proxy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.genai</groupId>
                <artifactId>google-genai</artifactId>
                <version>${google-genai.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <!-- CI speed: test classes run across one forked JVM per core (each fork runs its classes one at a
                         time). Classes tagged "sequential" (kills and child JVMs, crash matrices, hung-HTTP and
                         wall-clock timing) run afterwards in one fork, as before. Tags, not include lists, because -Dtest
                         overrides includes and excludes but is combined with groups: a test picked with -Dtest still
                         runs once. -->
                    <configuration>
                        <forkCount>1C</forkCount>
                        <reuseForks>true</reuseForks>
                        <excludedGroups>sequential</excludedGroups>
                    </configuration>
                    <executions>
                        <execution>
                            <id>sequential-tests</id>
                            <goals>
                                <goal>test</goal>
                            </goals>
                            <configuration>
                                <forkCount>1</forkCount>
                                <groups>sequential</groups>
                                <excludedGroups combine.self="override"/>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5-plugin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Section 15: Java 21. Fail the build on any other JDK. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>This build requires JDK 21 (section 15).</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- H3, ADR 0009: mutation testing with PIT. Binds nothing to any phase: it only configures pitest-maven, which is run by
             name, and never as part of ./mvnw verify. For example (a module, the classes to mutate):
               ./mvnw -B -ntp -Pmutation -pl agent-core test-compile org.pitest:pitest-maven:mutationCoverage \
                 -Dmutation.targetClasses=dev.ucplab.core.policy.RequotePolicy
             -Dmutation.mutators=DEFAULTS for classes that are not on a star path (default STRONGER). The property seed and the
             try count reach PIT's forked test JVMs (jvmArgs) and are mandatory here: with a random seed a kill would not be
             reproducible. verify keeps 10,000 schedules and its own seed handling. -->
        <profile>
            <id>mutation</id>
            <properties>
                <mutation.targetClasses>dev.ucplab.NOT_SET_use_mutation.targetClasses</mutation.targetClasses>
                <mutation.mutators>STRONGER</mutation.mutators>
                <!-- The module's own tests. agent-persistence puts core's test-jar on its classpath, whose tests read paths relative to
                     agent-core and fail there, so its run passes -Dmutation.targetTests='dev.ucplab.persistence.*' (one glob: a comma list on the command line matched nothing).
                     SqlCrashMatrixTest, the one persistence test in a core package (it needs the package-private CrashHarness of core's
                     test-jar), is selected by the second glob: -Dmutation.targetTests2='dev.ucplab.core.orchestrator.SqlCrashMatrixTest'. -->
                <mutation.targetTests>dev.ucplab.*</mutation.targetTests>
                <mutation.targetTests2>dev.ucplab.NONE</mutation.targetTests2>
                <mutation.extraExcludedTests>dev.ucplab.NONE</mutation.extraExcludedTests>
                <mutation.property.tries>500</mutation.property.tries>
                <mutation.property.seed>1</mutation.property.seed>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>${mutation.targetClasses}</param>
                            </targetClasses>
                            <!-- All of the module's tests, not the class's package: DefaultApprovalService.decide is covered by tests in
                                 other packages, and a narrow selection reads as no coverage (the H3 Stage 0 trap). -->
                            <targetTests>
                                <param>${mutation.targetTests}</param>
                                <param>${mutation.targetTests2}</param>
                            </targetTests>
                            <excludedTestClasses>
                                <!-- the evaluation harness starts servers and child JVMs (S9, S14): minutes per run, and not part of any star path -->
                                <param>dev.ucplab.eval.*</param>
                                <!-- ArchUnit scans class files; it passes on any mutant and costs seconds -->
                                <param>*ArchitectureTest</param>
                                <param>${mutation.extraExcludedTests}</param>
                            </excludedTestClasses>
                            <mutators>
                                <mutator>${mutation.mutators}</mutator>
                            </mutators>
                            <threads>4</threads>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>XML</param>
                                <param>HTML</param>
                            </outputFormats>
                            <reportsDirectory>${project.build.directory}/pit-reports</reportsDirectory>
                            <!-- No history files: PIT 1.30.2 refuses them without the commercial arcmutate history plugin ("History has been
                                 enabled but no history plugin has been installed"), so incremental analysis (plan option C) is not available. -->
                            <jvmArgs>
                                <jvmArg>-Dproperty.tries=${mutation.property.tries}</jvmArg>
                                <jvmArg>-Dproperty.seed=${mutation.property.seed}</jvmArg>
                                <!-- PIT's test JVMs write partial crash-matrix tables; only they may skip the comparison (CrashMatrixContract). -->
                                <jvmArg>-Dcrash.matrix.partial=allowed</jvmArg>
                            </jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
