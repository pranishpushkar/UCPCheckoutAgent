# Local-only values for `docker compose up` (DESIGN 25.4). Copy to .env; .env is never committed.
AGENT_PROFILE=local
# M6 keeps its data in SQLite on the named volume ucplab-data (D8). Postgres arrives with M7.
DATABASE_URL=jdbc:sqlite:/data/ucplab.db
# scripted needs no key and no network. gemini needs GEMINI_API_KEY in your shell, or the service refuses to start.
AGENT_MODEL=scripted
# A local placeholder, at least 32 bytes. The prod profile refuses it.
APPROVAL_SECRET=change-me-local-only-at-least-32-bytes
# The OIDC settings are unused until M6b (18.8), and MERCHANTS_FILE until M6a's registry; compose does not pass them.
OIDC_ISSUER=http://localhost:8081/realms/ucplab
OIDC_CLIENT_ID=ucplab-agent
OIDC_CLIENT_SECRET=change-me-local-only-at-least-32-bytes
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
MERCHANTS_FILE=/config/merchants.local.yaml
POLICY_FILE=/config/policy.yaml
# GEMINI_API_KEY is read from your shell only (export it before docker compose up); leave it empty here.
GEMINI_API_KEY=
