<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ucplab</groupId>
        <artifactId>ucp-checkout-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-adk</artifactId>
    <name>Agent ADK runtime</name>

    <dependencies>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <!-- The only module that imports Gemini SDK (or ADK) types (5.2, ADR 0004). -->
        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
        </dependency>
        <!-- Tests only: GeminiSchemaKeywordsTest sends the five tools' real schemas (C15 VERIFY). Main code depends on
             core alone; agent-runtime never depends on this module. -->
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-runtime</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- One live round trip with the Gemini API (C1, ADR 0004). Needs GEMINI_API_KEY in the environment; never part
             of a plain verify, which runs no *IT class. -->
        <profile>
            <id>live-spike</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
