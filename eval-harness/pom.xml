<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ucplab</groupId>
        <artifactId>ucp-checkout-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>eval-harness</artifactId>
    <name>Evaluation harness</name>

    <!-- Section 5.2 (D2): until M6 there is no REST API, so the harness embeds the agent and starts lab merchants in
         process. Never agent-adk or ADK types. -->
    <dependencies>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-ucp</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-persistence</artifactId>
        </dependency>
        <!-- Decision 1: the agent runtime (JDK and core only), never agent-adk, ADK or the Gemini SDK. -->
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>fault-proxy</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>merchant</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- 13.5, section 15, Decision 1: the acceptance report. ./mvnw -B -ntp verify -Peval-full runs the whole
             build, then EvalMain with 200 runs per scenario at time scale 1 on 16 lanes. Its require-full flag
             refuses anything less (exit 3), and any non-zero exit fails the build. The report goes to
             target/eval-full. eval.runs and eval.lanes exist only to check this wiring; the acceptance run uses the
             defaults. -->
        <profile>
            <id>eval-full</id>
            <properties>
                <eval.runs>200</eval.runs>
                <eval.lanes>16</eval.lanes>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>eval-full</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>dev.ucplab.eval.EvalMain</argument>
                                        <argument>--mode</argument>
                                        <argument>scripted</argument>
                                        <argument>--runs</argument>
                                        <argument>${eval.runs}</argument>
                                        <argument>--time-scale</argument>
                                        <argument>1</argument>
                                        <argument>--lanes</argument>
                                        <argument>${eval.lanes}</argument>
                                        <argument>--require-full</argument>
                                        <argument>--out</argument>
                                        <argument>${project.build.directory}/eval-full</argument>
                                    </arguments>
                                    <classpathScope>runtime</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- C16, m5-plan section 10, Decision 1: the live evaluation. agent-adk joins at runtime scope only, so
             ModelClients.load("gemini", key) finds its provider through ServiceLoader; the harness never compiles
             against it. ./mvnw -B -ntp verify -Peval-live -DskipTests -pl eval-harness -am runs EvalMain in live mode on
             S10 and S12 with GEMINI_API_KEY from the environment (never a property or an argument). The caps default
             to $5 and 2,000,000 tokens and may only be lowered. -Deval.live.model picks another model with a price
             file (default: the pinned gemini-3.8-flash). The report goes to target/eval-live. -->
        <profile>
            <id>eval-live</id>
            <properties>
                <eval.live.model>gemini-3.8-flash</eval.live.model>
                <eval.live.runs>30</eval.live.runs>
                <eval.live.lanes>2</eval.live.lanes>
                <eval.live.maxCostUsd>5</eval.live.maxCostUsd>
                <eval.live.maxTokensTotal>2000000</eval.live.maxTokensTotal>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>dev.ucplab</groupId>
                    <artifactId>agent-adk</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>eval-live</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>dev.ucplab.eval.EvalMain</argument>
                                        <argument>--mode</argument>
                                        <argument>live</argument>
                                        <argument>--model</argument>
                                        <argument>${eval.live.model}</argument>
                                        <argument>--runs</argument>
                                        <argument>${eval.live.runs}</argument>
                                        <argument>--time-scale</argument>
                                        <argument>1</argument>
                                        <argument>--lanes</argument>
                                        <argument>${eval.live.lanes}</argument>
                                        <argument>--evidence</argument>
                                        <argument>all</argument>
                                        <argument>--max-cost-usd</argument>
                                        <argument>${eval.live.maxCostUsd}</argument>
                                        <argument>--max-tokens-total</argument>
                                        <argument>${eval.live.maxTokensTotal}</argument>
                                        <argument>--out</argument>
                                        <argument>${project.build.directory}/eval-live</argument>
                                    </arguments>
                                    <classpathScope>runtime</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- H1 C7/C8, DESIGN 26.5: the interop rows against the official sample merchant. Third-party code: it runs only here,
             never in verify, from the clone scripts/interop-fetch.sh makes in target/interop, bound to 127.0.0.1.
             ./mvnw -B -ntp verify -Pinterop -DskipTests -pl eval-harness -am (after scripts/interop-fetch.sh). -->
        <profile>
            <id>interop</id>
            <properties>
                <interop.runs>20</interop.runs>
                <interop.lanes>4</interop.lanes>
                <interop.k>4</interop.k>
                <interop.trace>false</interop.trace>
                <interop.rows>S0,S1,S2,S3,S4,S5,S6,S7,S8,S13,S14</interop.rows>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>interop</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>-Dinterop.repo=${project.basedir}/..</argument>
                                        <argument>-Dinterop.runs=${interop.runs}</argument>
                                        <argument>-Dinterop.lanes=${interop.lanes}</argument>
                                        <argument>-Dinterop.k=${interop.k}</argument>
                                        <argument>-Dinterop.trace=${interop.trace}</argument>
                                        <argument>-Dinterop.rows=${interop.rows}</argument>
                                        <argument>dev.ucplab.eval.interop.InteropMain</argument>
                                    </arguments>
                                    <classpathScope>runtime</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
