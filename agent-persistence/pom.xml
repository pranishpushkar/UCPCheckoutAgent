<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ucplab</groupId>
        <artifactId>ucp-checkout-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-persistence</artifactId>
    <name>Agent persistence</name>

    <dependencies>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Database configures connections through org.sqlite.SQLiteConfig (ADR 0002). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ucplab</groupId>
            <artifactId>agent-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- CI speed: the test JVM's temp directory, where @TempDir puts the SQLite files. CI sets test.tmpdir to /dev/shm
         (tmpfs), so a commit's fsync costs nothing there; locally it is the usual temp directory. Only the place the files
         live changes: the same SQL, pragmas, tries and seeds. -->
    <properties>
        <test.tmpdir>${java.io.tmpdir}</test.tmpdir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.io.tmpdir=${test.tmpdir}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
